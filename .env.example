APP_NAME="CADCOLAB ENFAS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cadcolab.enfas.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cadcolab
DB_USERNAME=cadcolab
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@enfas.com.br"
MAIL_FROM_NAME="CADCOLAB ENFAS"

# -----------------------------------------------------------------------------
# Identity & Directory - LDAP / Active Directory
# -----------------------------------------------------------------------------
IDENTITY_DIRECTORY_ENABLED=false
IDENTITY_LOCAL_FALLBACK=true
IDENTITY_SYNC_ON_LOGIN=true

LDAP_HOST=ad.enfas.local
LDAP_PORT=636
LDAP_SSL=true
LDAP_START_TLS=false
LDAP_TIMEOUT=5
LDAP_BASE_DN="DC=enfas,DC=local"
LDAP_USERS_DN="OU=Usuarios,DC=enfas,DC=local"
LDAP_GROUPS_DN="OU=Grupos,DC=enfas,DC=local"
LDAP_BIND_DN="CN=svc-cadcolab,OU=Servicos,DC=enfas,DC=local"
LDAP_BIND_PASSWORD=
LDAP_ACCOUNT_SUFFIX="@enfas.local"
LDAP_USER_FILTER="(&(objectCategory=person)(objectClass=user))"
LDAP_GROUP_FILTER="(objectClass=group)"
LDAP_USERNAME_ATTRIBUTE=sAMAccountName

LDAP_ATTR_GUID=objectGUID
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_UPN=userPrincipalName
LDAP_ATTR_NAME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_EMPLOYEE_ID=employeeID
LDAP_ATTR_DEPARTMENT=department
LDAP_ATTR_TITLE=title
LDAP_ATTR_PHONE=telephoneNumber
LDAP_ATTR_MOBILE=mobile
LDAP_ATTR_MANAGER=manager
LDAP_ATTR_GROUPS=memberOf
LDAP_ATTR_ACCOUNT_CONTROL=userAccountControl

# Os nomes abaixo são CNs dos grupos do AD que definem o perfil no CADCOLAB.
LDAP_ADMIN_GROUPS="CADCOLAB-ADMIN"
LDAP_TI_GROUPS="CADCOLAB-TI"
LDAP_RH_GROUPS="CADCOLAB-RH"
LDAP_DEFAULT_PROFILE=Operador

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
